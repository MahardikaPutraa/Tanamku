APP_NAME=TanamKu
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://your-domain.up.railway.app
APP_LOCALE=id
APP_FALLBACK_LOCALE=id

LOG_CHANNEL=stack
LOG_LEVEL=error

# -----------------------------------------------------------------------------
# Database (PostgreSQL Neon)
# Gunakan Direct Host (tanpa -pooler) agar kompatibel penuh dengan locking transaksi Laravel
# -----------------------------------------------------------------------------
DB_CONNECTION=pgsql
# Opsi 1 (Satu Baris via DB_URL):
# DB_URL="postgresql://neondb_owner:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Opsi 2 (Per parameter):
DB_HOST=ep-xxxx.ap-southeast-1.aws.neon.tech
DB_PORT=5432
DB_DATABASE=neondb
DB_USERNAME=neondb_owner
DB_PASSWORD=password_dari_neon
DB_SSLMODE=require

# Driver Session & Cache
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=database

FILESYSTEM_DISK=public

